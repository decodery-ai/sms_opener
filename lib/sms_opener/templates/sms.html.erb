<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SMS to <%= CGI.escapeHTML(to_display) %> — SmsOpener</title>
  <style>
    :root {
      --bg: #0f172a;
      --card-bg: #1e293b;
      --border: #334155;
      --text: #f8fafc;
      --muted: #94a3b8;
      --accent: #38bdf8;
      --bubble-bg: #2563eb;
      --bubble-text: #ffffff;
      --success: #10b981;
      --warning: #f59e0b;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      padding: 24px 16px;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      display: flex;
      justify-content: center;
      min-height: 100vh;
    }
    .container {
      width: 100%;
      max-width: 820px;
      display: grid;
      grid-template-columns: 360px 1fr;
      gap: 24px;
      align-items: start;
    }
    @media (max-width: 760px) {
      .container { grid-template-columns: 1fr; }
    }
    /* Phone device frame */
    .phone-frame {
      background: #090d16;
      border: 4px solid #334155;
      border-radius: 36px;
      padding: 14px;
      box-shadow: 0 20px 45px rgba(0, 0, 0, 0.5);
    }
    .phone-screen {
      background: #111827;
      border-radius: 24px;
      overflow: hidden;
      min-height: 520px;
      display: flex;
      flex-direction: column;
    }
    .phone-statusbar {
      padding: 10px 18px 6px;
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      font-weight: 600;
      color: var(--muted);
    }
    .phone-header {
      padding: 12px 16px;
      background: rgba(30, 41, 59, 0.85);
      border-bottom: 1px solid var(--border);
      text-align: center;
    }
    .avatar-circle {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: linear-gradient(135deg, #3b82f6, #6366f1);
      color: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 15px;
      margin-bottom: 4px;
    }
    .sender-label {
      font-size: 13px;
      font-weight: 600;
      color: var(--text);
      word-break: break-all;
    }
    .recipient-sub {
      font-size: 11px;
      color: var(--muted);
      margin-top: 2px;
    }
    .chat-area {
      flex: 1;
      padding: 18px 14px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .chat-timestamp {
      text-align: center;
      font-size: 11px;
      color: var(--muted);
      margin-bottom: 6px;
    }
    .sms-bubble {
      background: var(--bubble-bg);
      color: var(--bubble-text);
      padding: 12px 15px;
      border-radius: 18px 18px 18px 4px;
      max-width: 90%;
      line-height: 1.45;
      font-size: 14.5px;
      word-wrap: break-word;
      box-shadow: 0 2px 8px rgba(37, 99, 235, 0.25);
    }
    .sms-bubble a.sms-link {
      color: #bae6fd;
      text-decoration: underline;
      word-break: break-all;
    }
    .mms-media {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-top: 8px;
    }
    .mms-media img {
      max-width: 100%;
      border-radius: 12px;
      border: 1px solid var(--border);
    }
    .mms-media a {
      font-size: 12px;
      color: var(--accent);
    }
    /* Inspector panel */
    .inspector {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .panel {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 18px;
    }
    .panel-title {
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
      margin: 0 0 12px 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .badge {
      display: inline-block;
      padding: 3px 9px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 600;
      background: rgba(56, 189, 248, 0.15);
      color: var(--accent);
    }
    .badge.warning {
      background: rgba(245, 158, 11, 0.18);
      color: var(--warning);
    }
    .badge.success {
      background: rgba(16, 185, 129, 0.18);
      color: var(--success);
    }
    .otp-banner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.4);
      border-radius: 12px;
      padding: 14px 16px;
    }
    .otp-code-value {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 22px;
      font-weight: 700;
      letter-spacing: 0.12em;
      color: #34d399;
    }
    .btn {
      cursor: pointer;
      background: #10b981;
      color: #06281e;
      border: none;
      border-radius: 8px;
      padding: 8px 14px;
      font-size: 13px;
      font-weight: 700;
      transition: opacity 0.15s;
    }
    .btn:hover { opacity: 0.9; }
    .meta-grid {
      display: grid;
      grid-template-columns: 120px 1fr;
      row-gap: 10px;
      column-gap: 12px;
      font-size: 13.5px;
    }
    .meta-label { color: var(--muted); font-weight: 500; }
    .meta-value {
      color: var(--text);
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      word-break: break-all;
    }
    .links-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .links-list a {
      display: block;
      padding: 8px 12px;
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--accent);
      text-decoration: none;
      font-size: 13px;
      word-break: break-all;
    }
    .links-list a:hover {
      border-color: var(--accent);
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Mobile Device Preview -->
    <div class="phone-frame">
      <div class="phone-screen">
        <div class="phone-statusbar">
          <span><%= created_at.strftime("%H:%M") %></span>
          <span>5G • 100%</span>
        </div>
        <div class="phone-header">
          <div class="avatar-circle">SMS</div>
          <div class="sender-label"><%= CGI.escapeHTML(from) %></div>
          <div class="recipient-sub">To: <%= CGI.escapeHTML(to_display) %></div>
        </div>
        <div class="chat-area">
          <div class="chat-timestamp"><%= created_at.strftime("%b %d, %Y at %I:%M:%S %p") %></div>
          <div class="sms-bubble" id="sms-body"><%= formatted_body_html %></div>
          <% unless media_urls.empty? -%>
            <div class="mms-media">
              <% media_urls.each do |url| -%>
                <img src="<%= CGI.escapeHTML(url) %>" alt="MMS Attachment" onerror="this.style.display='none'">
                <a href="<%= CGI.escapeHTML(url) %>" target="_blank" rel="noopener noreferrer"><%= CGI.escapeHTML(url) %></a>
              <% end -%>
            </div>
          <% end -%>
        </div>
      </div>
    </div>

    <!-- Developer Metadata & Quick Actions -->
    <div class="inspector">
      <% if otp_code -%>
        <div class="otp-banner">
          <div>
            <div style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: #a7f3d0; margin-bottom: 2px;">Detected Verification Code</div>
            <div class="otp-code-value" id="otp-code"><%= CGI.escapeHTML(otp_code) %></div>
          </div>
          <button class="btn" type="button" onclick="navigator.clipboard.writeText('<%= CGI.escapeHTML(otp_code) %>'); this.textContent = 'Copied!'; setTimeout(() => this.textContent = 'Copy OTP', 1500);">Copy OTP</button>
        </div>
      <% end -%>

      <div class="panel">
        <div class="panel-title">
          <span>Delivery Details</span>
          <span class="badge"><%= CGI.escapeHTML(provider.upcase) %></span>
        </div>
        <div class="meta-grid">
          <div class="meta-label">Message ID</div>
          <div class="meta-value"><%= CGI.escapeHTML(id) %></div>

          <div class="meta-label">From</div>
          <div class="meta-value"><%= CGI.escapeHTML(from) %></div>

          <div class="meta-label">To</div>
          <div class="meta-value"><%= CGI.escapeHTML(to_display) %></div>

          <div class="meta-label">Timestamp</div>
          <div class="meta-value"><%= CGI.escapeHTML(created_at.iso8601) %></div>
        </div>
      </div>

      <div class="panel">
        <div class="panel-title">
          <span>SMS Segment &amp; Encoding Analysis</span>
          <span class="badge <%= segments > 1 || encoding == 'UCS-2' ? 'warning' : 'success' %>">
            <%= segments %> <%= segments == 1 ? 'Segment' : 'Segments' %> (<%= encoding %>)
          </span>
        </div>
        <div class="meta-grid">
          <div class="meta-label">Encoding</div>
          <div class="meta-value"><%= encoding %></div>

          <div class="meta-label">Characters</div>
          <div class="meta-value"><%= character_count %></div>

          <div class="meta-label">Segments</div>
          <div class="meta-value"><%= segments %></div>
        </div>
      </div>

      <% unless urls.empty? -%>
        <div class="panel">
          <div class="panel-title"><span>Extracted Links (<%= urls.size %>)</span></div>
          <ul class="links-list">
            <% urls.each do |url| -%>
              <li><a href="<%= CGI.escapeHTML(url) %>" target="_blank" rel="noopener noreferrer"><%= CGI.escapeHTML(url) %></a></li>
            <% end -%>
          </ul>
        </div>
      <% end -%>

      <% unless metadata.empty? -%>
        <div class="panel">
          <div class="panel-title"><span>Provider Metadata</span></div>
          <div class="meta-grid">
            <% metadata.each do |key, val| -%>
              <div class="meta-label"><%= CGI.escapeHTML(key.to_s) %></div>
              <div class="meta-value"><%= CGI.escapeHTML(val.to_s) %></div>
            <% end -%>
          </div>
        </div>
      <% end -%>
    </div>
  </div>
</body>
</html>
